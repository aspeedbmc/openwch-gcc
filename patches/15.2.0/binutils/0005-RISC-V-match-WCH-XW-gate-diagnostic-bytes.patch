diff --git a/gas/config/tc-riscv.c b/gas/config/tc-riscv.c
index 9e89c6c6..fe55de82 100644
--- a/gas/config/tc-riscv.c
+++ b/gas/config/tc-riscv.c
@@ -2901,13 +2901,36 @@ riscv_ip (char *str, struct riscv_cl_insn *ip, expressionS *imm_expr,
       if ((insn->xlen_requirement != 0) && (xlen != insn->xlen_requirement))
 	continue;
 
-      if (insn->insn_class == INSN_CLASS_XW)
+      /* WCH keeps reporting XW candidates as a missing compressed extension
+	 while compressed instruction assembly is disabled, so reject them
+	 before the operand diagnostic is reset below.  Every XW encoding is
+	 16 bits wide, so what the user is missing is C or Zca rather than XW
+	 itself; unlike the ordinary gate below this one therefore reports
+	 INSN_CLASS_ZCA instead of the candidate's own class.  Rejecting here
+	 only anticipates the rejection that the instruction length check
+	 further down would make for these entries anyway.
+
+	 This gate and the XW test after the reset partition the XW state
+	 space; neither is redundant:
+
+	   riscv_opts.rvc  xw_enabled  XW candidate rejected by
+	   false           either      this gate
+	   true            false       the gate after the reset
+	   true            true        neither, the encoding is assembled
+
+	 Both rely on the opcode table listing the XW entry of a mnemonic
+	 ahead of its non-XW entries, so that a later candidate of the same
+	 mnemonic still overwrites the extension recorded here.  */
+      if (insn->insn_class == INSN_CLASS_XW
+	  && !riscv_opts.rvc)
 	{
-	  if (!xw_enabled)
-	    continue;
+	  error.missing_ext = riscv_multi_subset_supports_ext (&riscv_rps_as,
+							       INSN_CLASS_ZCA);
+	  continue;
 	}
-      else if (!riscv_multi_subset_supports (&riscv_rps_as,
-					     insn->insn_class))
+
+      if (insn->insn_class != INSN_CLASS_XW
+	  && !riscv_multi_subset_supports (&riscv_rps_as, insn->insn_class))
 	{
 	  error.missing_ext = riscv_multi_subset_supports_ext (&riscv_rps_as,
 							       insn->insn_class);
@@ -2917,6 +2940,14 @@ riscv_ip (char *str, struct riscv_cl_insn *ip, expressionS *imm_expr,
       error.msg = _("illegal operands");
       error.missing_ext = NULL;
 
+      /* WCH uses the initial XW eligibility for both its private compressed
+	 encodings and the conflicting standard double-float encodings.  Only
+	 the compressed-assembly-enabled half of the XW state space reaches
+	 this test; the gate above already rejected the disabled half.  */
+      if ((insn->insn_class == INSN_CLASS_XW && !xw_enabled)
+	  || (insn->insn_class == INSN_CLASS_ZCD && xw_enabled))
+	continue;
+
       /* Purge deferred symbols from the previous round, if any.  */
       while (deferred_sym_rootP)
 	{
