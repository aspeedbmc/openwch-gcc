diff --git a/gas/config/tc-riscv.c b/gas/config/tc-riscv.c
index c2d38f43..9e89c6c6 100644
--- a/gas/config/tc-riscv.c
+++ b/gas/config/tc-riscv.c
@@ -474,6 +474,14 @@ const char FLT_CHARS[] = "rRsSfFdDxXpPhHbB";
 /* Indicate ELF attributes are explicitly set.  */
 static bool explicit_attr = false;
 
+/* Indicate the synthesised RISC-V ELF attributes should be written out.
+   WCH leaves them out of an object unless --w_priv_spec is given, so the
+   arch, stack alignment and privileged spec tags that finish-time synthesis
+   would add are opt-in; an explicit .attribute directive still records its
+   operand, and records it verbatim rather than canonicalised.  The name is
+   the one the official assembler accepts.  */
+static bool w_priv_spec = false;
+
 /* Indicate CSR or priv instructions are explicitly used.  */
 static bool explicit_priv_attr = false;
 
@@ -4537,6 +4545,7 @@ enum options
   OPTION_NO_RELAX,
   OPTION_ARCH_ATTR,
   OPTION_NO_ARCH_ATTR,
+  OPTION_W_PRIV_SPEC,
   OPTION_CSR_CHECK,
   OPTION_NO_CSR_CHECK,
   OPTION_MISA_SPEC,
@@ -4557,6 +4566,9 @@ const struct option md_longopts[] =
   {"mno-relax", no_argument, NULL, OPTION_NO_RELAX},
   {"march-attr", no_argument, NULL, OPTION_ARCH_ATTR},
   {"mno-arch-attr", no_argument, NULL, OPTION_NO_ARCH_ATTR},
+  /* Deliberately absent from md_show_usage: the official assembler accepts
+     this option but neither --help nor --target-help lists it.  */
+  {"w_priv_spec", no_argument, NULL, OPTION_W_PRIV_SPEC},
   {"mcsr-check", no_argument, NULL, OPTION_CSR_CHECK},
   {"mno-csr-check", no_argument, NULL, OPTION_NO_CSR_CHECK},
   {"misa-spec", required_argument, NULL, OPTION_MISA_SPEC},
@@ -4633,6 +4645,10 @@ md_parse_option (int c, const char *arg)
       riscv_opts.arch_attr = false;
       break;
 
+    case OPTION_W_PRIV_SPEC:
+      w_priv_spec = true;
+      break;
+
     case OPTION_CSR_CHECK:
       riscv_opts.csr_check = true;
       break;
@@ -5794,7 +5810,22 @@ riscv_write_out_attrs (void)
 static void
 riscv_set_public_attributes (void)
 {
-  if (riscv_opts.arch_attr || explicit_attr)
+  /* WCH keeps the upstream condition and requires --w_priv_spec on top of
+     it, which is why -march-attr looks like a no-op there: it sets a flag
+     that DEFAULT_RISCV_ATTR already set.  The four combinations, all of
+     them probed on the official 15.2.0 assembler, are
+
+       --w_priv_spec  arch_attr || explicit_attr  .riscv.attributes
+       no             either                      absent, or exactly what
+						  a .attribute directive
+						  wrote, uncanonicalised
+       yes            false                       absent
+       yes            true                        synthesised as upstream
+
+     so -mno-arch-attr still switches synthesis off with the option given,
+     and the section an explicit .attribute directive creates is rewritten
+     into canonical form only when synthesis runs.  */
+  if (w_priv_spec && (riscv_opts.arch_attr || explicit_attr))
     riscv_write_out_attrs ();
 }
 
diff --git a/gas/testsuite/gas/elf/elf.exp b/gas/testsuite/gas/elf/elf.exp
index 1f42c3f3..2c82ceb3 100644
--- a/gas/testsuite/gas/elf/elf.exp
+++ b/gas/testsuite/gas/elf/elf.exp
@@ -89,7 +89,9 @@ if { [is_elf_format] } then {
     }
     if {[istarget "riscv*-*-*"]} then {
 	set target_machine -riscv
-	set dump_opts {{as -mno-relax}}
+	# The RISC-V attribute section these expectations include is written
+	# out only when asked for.
+	set dump_opts {{as -mno-relax --w_priv_spec}}
     }
     if {[istarget "rl78-*-*"]} then {
 	set target_machine -rl78
@@ -211,7 +213,7 @@ if { [is_elf_format] } then {
 		set as_flags "$as_flags -mx86-used-note=no"
 	    }
 	    riscv*-*-* {
-		set as_flags "$as_flags -march-attr"
+		set as_flags "$as_flags -march-attr --w_priv_spec"
 	    }
 	    mips*-*-irix* {
 		# Irix has no pdr section by default.
