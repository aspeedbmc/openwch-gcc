diff --git a/gas/config/tc-riscv.c b/gas/config/tc-riscv.c
index 8a335688..9626a2a3 100644
--- a/gas/config/tc-riscv.c
+++ b/gas/config/tc-riscv.c
@@ -169,6 +169,9 @@ struct riscv_ip_error
 
 static const char default_arch[] = DEFAULT_ARCH;
 static const char *default_arch_with_ext = DEFAULT_RISCV_ARCH_WITH_EXT;
+/* True when the initial architecture had both C and XW.  The XW encodings
+   additionally need current RVC assembly; riscv_ip tests both.  */
+static bool xw_enabled;
 static const char *file_arch_str = NULL;
 static enum riscv_spec_class default_isa_spec = ISA_SPEC_CLASS_NONE;
 static enum riscv_spec_class default_priv_spec = PRIV_SPEC_CLASS_NONE;
@@ -361,6 +364,12 @@ riscv_set_arch (const char *s)
   riscv_arch_str (xlen, riscv_rps_as.subset_list, true/* update */);
   file_arch_str = strdup (riscv_rps_as.subset_list->arch_str);
 
+  /* WCH keeps the XW compressed eligibility established by the command-line
+     architecture or an ELF architecture attribute.  Source-level .option
+     arch changes do not establish this eligibility.  */
+  xw_enabled |= (riscv_subset_supports (&riscv_rps_as, "xw")
+		 && riscv_subset_supports (&riscv_rps_as, "c"));
+
   riscv_set_rvc (riscv_subset_supports (&riscv_rps_as, "c")
 		 || riscv_subset_supports (&riscv_rps_as, "zca"));
 
@@ -1675,6 +1684,17 @@ validate_riscv_insn (const struct riscv_opcode *opc, int length)
 	case 'X': /* Vendor-specific operands.  */
 	  switch (*++oparg)
 	    {
+	    case 'w': /* Vendor-specific (WCH) XW operands.  */
+	      switch (*++oparg)
+		{
+		case 'b': used_bits |= ENCODE_XW_REG_BYTE_UIMM (-1U); break;
+		case 'h': used_bits |= ENCODE_XW_REG_HALF_UIMM (-1U); break;
+		case 'B': used_bits |= ENCODE_XW_SP_BYTE_UIMM (-1U); break;
+		case 'H': used_bits |= ENCODE_XW_SP_HALF_UIMM (-1U); break;
+		default:
+		  goto unknown_validate_operand;
+		}
+	      break;
 	    case 't': /* Vendor-specific (T-head) operands.  */
 	      {
 		size_t n;
@@ -2872,13 +2892,18 @@ riscv_ip (char *str, struct riscv_cl_insn *ip, expressionS *imm_expr,
       if ((insn->xlen_requirement != 0) && (xlen != insn->xlen_requirement))
 	continue;
 
-      if (!riscv_multi_subset_supports (&riscv_rps_as, insn->insn_class))
+      if (insn->insn_class == INSN_CLASS_XW)
+	{
+	  if (!xw_enabled)
+	    continue;
+	}
+      else if (!riscv_multi_subset_supports (&riscv_rps_as,
+					     insn->insn_class))
 	{
 	  error.missing_ext = riscv_multi_subset_supports_ext (&riscv_rps_as,
 							       insn->insn_class);
 	  continue;
 	}
-
       /* Reset error message of the previous round.  */
       error.msg = _("illegal operands");
       error.missing_ext = NULL;
@@ -3981,6 +4006,53 @@ riscv_ip (char *str, struct riscv_cl_insn *ip, expressionS *imm_expr,
 	    case 'X': /* Vendor-specific operands.  */
 	      switch (*++oparg)
 		{
+		case 'w': /* Vendor-specific (WCH) XW operands.  */
+		  switch (*++oparg)
+		    {
+		    case 'b':
+		      if (riscv_handle_implicit_zero_offset (imm_expr, asarg))
+			continue;
+		      if (my_getSmallExpression (imm_expr, imm_reloc, asarg, p)
+			  || imm_expr->X_op != O_constant
+			  || !VALID_XW_REG_BYTE_UIMM (imm_expr->X_add_number))
+			break;
+		      ip->insn_opcode
+			|= ENCODE_XW_REG_BYTE_UIMM (imm_expr->X_add_number);
+		      goto rvc_imm_done;
+		    case 'h':
+		      if (riscv_handle_implicit_zero_offset (imm_expr, asarg))
+			continue;
+		      if (my_getSmallExpression (imm_expr, imm_reloc, asarg, p)
+			  || imm_expr->X_op != O_constant
+			  || !VALID_XW_REG_HALF_UIMM (imm_expr->X_add_number))
+			break;
+		      ip->insn_opcode
+			|= ENCODE_XW_REG_HALF_UIMM (imm_expr->X_add_number);
+		      goto rvc_imm_done;
+		    case 'B':
+		      if (riscv_handle_implicit_zero_offset (imm_expr, asarg))
+			continue;
+		      if (my_getSmallExpression (imm_expr, imm_reloc, asarg, p)
+			  || imm_expr->X_op != O_constant
+			  || !VALID_XW_SP_BYTE_UIMM (imm_expr->X_add_number))
+			break;
+		      ip->insn_opcode
+			|= ENCODE_XW_SP_BYTE_UIMM (imm_expr->X_add_number);
+		      goto rvc_imm_done;
+		    case 'H':
+		      if (riscv_handle_implicit_zero_offset (imm_expr, asarg))
+			continue;
+		      if (my_getSmallExpression (imm_expr, imm_reloc, asarg, p)
+			  || imm_expr->X_op != O_constant
+			  || !VALID_XW_SP_HALF_UIMM (imm_expr->X_add_number))
+			break;
+		      ip->insn_opcode
+			|= ENCODE_XW_SP_HALF_UIMM (imm_expr->X_add_number);
+		      goto rvc_imm_done;
+		    default:
+		      goto unknown_riscv_ip_operand;
+		    }
+		  break;
 		case 't': /* Vendor-specific (T-head) operands.  */
 		  {
 		    size_t n;
