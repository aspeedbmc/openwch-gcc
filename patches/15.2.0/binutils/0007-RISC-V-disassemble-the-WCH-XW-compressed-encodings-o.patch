diff --git a/opcodes/riscv-dis.c b/opcodes/riscv-dis.c
index f9e4d388..56cf7d1a 100644
--- a/opcodes/riscv-dis.c
+++ b/opcodes/riscv-dis.c
@@ -72,6 +72,11 @@ struct riscv_private_data
   /* If set, disassemble without checking architecture string, just like what
      we did at the beginning.  */
   bool all_ext;
+  /* If set, decode the WCH XW compressed encodings.  These are keyed on this
+     option alone: an XW architecture attribute does not enable them and
+     all_ext does not either, since the encodings they occupy already belong
+     to the standard compressed double-float instructions.  */
+  bool xw;
 };
 
 /* Set default RISC-V disassembler options.  */
@@ -84,6 +89,7 @@ set_default_riscv_dis_options (struct disassemble_info *info)
   pd->riscv_fpr_names = riscv_fpr_names_abi;
   pd->no_aliases = false;
   pd->all_ext = false;
+  pd->xw = false;
 }
 
 /* Parse RISC-V disassembler option (without arguments).  */
@@ -102,6 +108,8 @@ parse_riscv_dis_option_without_args (const char *option,
     }
   else if (strcmp (option, "max") == 0)
     pd->all_ext = true;
+  else if (strcmp (option, "xw") == 0)
+    pd->xw = true;
   else
     return false;
   return true;
@@ -772,6 +780,29 @@ print_insn_args (const char *oparg, insn_t l, bfd_vma pc, disassemble_info *info
 	case 'X': /* Vendor-specific operands.  */
 	  switch (*++oparg)
 	    {
+	    case 'w': /* Vendor-specific (WCH) XW operands.  */
+	      switch (*++oparg)
+		{
+		case 'b':
+		  print (info->stream, dis_style_immediate, "%d",
+			 (int) EXTRACT_XW_REG_BYTE_UIMM (l));
+		  break;
+		case 'h':
+		  print (info->stream, dis_style_immediate, "%d",
+			 (int) EXTRACT_XW_REG_HALF_UIMM (l));
+		  break;
+		case 'B':
+		  print (info->stream, dis_style_immediate, "%d",
+			 (int) EXTRACT_XW_SP_BYTE_UIMM (l));
+		  break;
+		case 'H':
+		  print (info->stream, dis_style_immediate, "%d",
+			 (int) EXTRACT_XW_SP_HALF_UIMM (l));
+		  break;
+		default:
+		  goto undefined_modifier;
+		}
+	      break;
 	    case 't': /* Vendor-specific (T-head) operands.  */
 	      {
 		size_t n;
@@ -1016,8 +1047,13 @@ riscv_disassemble_insn (bfd_vma memaddr,
 
       for (; op->name; op++)
 	{
-	  /* The WCH disassembler prints XW compressed encodings as .insn.  */
-	  if (op->insn_class == INSN_CLASS_XW)
+	  /* The XW compressed encodings are shown only when they were asked
+	     for by name.  Without the option they print as .insn, which is
+	     also what an XW architecture attribute alone produces, so the
+	     ordinary architecture test below cannot decide them.  Which of
+	     several matching encodings wins is left to the table order, as
+	     for every other class.  */
+	  if (op->insn_class == INSN_CLASS_XW && !pd->xw)
 	    continue;
 	  /* Ignore macro insns.  */
 	  if (op->pinfo == INSN_MACRO)
@@ -1032,8 +1068,11 @@ riscv_disassemble_insn (bfd_vma memaddr,
 	  if ((op->xlen_requirement != 0)
 	      && (op->xlen_requirement != pd->xlen))
 	    continue;
-	  /* Is this instruction supported by the current architecture?  */
-	  if (!pd->all_ext
+	  /* Is this instruction supported by the current architecture?  The
+	     XW class is exempt: -Mxw enables it against any architecture and
+	     -Mmax does not enable it against any.  */
+	  if (op->insn_class != INSN_CLASS_XW
+	      && !pd->all_ext
 	      && !riscv_multi_subset_supports (&pd->riscv_rps_dis,
 					       op->insn_class))
 	    continue;
@@ -1491,6 +1530,7 @@ riscv_init_disasm_info (struct disassemble_info *info)
   pd->riscv_fpr_names = NULL;
   pd->no_aliases = false;
   pd->all_ext = false;
+  pd->xw = false;
 
   info->private_data = pd;
   riscv_dis_parse_subset (info, pd->default_arch);
@@ -1643,6 +1683,10 @@ static struct
   { "no-aliases",
     N_("Disassemble only into canonical instructions."),
     RISCV_OPTION_ARG_NONE },
+  { "xw",
+    N_("Enable WCH compressed instruction extension, such as\n"
+       "\t\tlbu lhu sb sh lbusp lhusp sbsp shsp"),
+    RISCV_OPTION_ARG_NONE },
   { "priv-spec=",
     N_("Print the CSR according to the chosen privilege spec."),
     RISCV_OPTION_ARG_PRIV_SPEC }
