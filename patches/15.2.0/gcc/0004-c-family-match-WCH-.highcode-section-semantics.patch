diff --git a/gcc/testsuite/gcc.target/riscv/wch-highcode-sections.c b/gcc/testsuite/gcc.target/riscv/wch-highcode-sections.c
new file mode 100644
index 000000000..3220b448c
--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/wch-highcode-sections.c
@@ -0,0 +1,63 @@
+/* { dg-do compile } */
+/* { dg-options "-march=rv32imac -mabi=ilp32 --param highcode-gen-section-name=1" } */
+
+int source_name (int) __asm__ ("assembler_name");
+
+int __attribute__ ((section (".highcode"), used))
+source_name (int x)
+{
+  return x + 1;
+}
+
+int __attribute__ ((section (".highcode"), used)) highcode_object = 1;
+
+static int __attribute__ ((section (".highcode"), used))
+static_highcode_object = 2;
+
+int
+local_static_owner (void)
+{
+  static int __attribute__ ((section (".highcode"), used)) local_object = 3;
+  return local_object + static_highcode_object;
+}
+
+int __attribute__ ((section (".highcode.extra"), used))
+prefix_name (int x)
+{
+  return x + 2;
+}
+
+int __attribute__ ((section (".highcode_init"), used))
+init_name (int x)
+{
+  return x + 3;
+}
+
+int __attribute__ ((section (".Highcode"), used))
+case_name (int x)
+{
+  return x + 4;
+}
+
+int __attribute__ ((section (".highcode "), used))
+space_name (int x)
+{
+  return x + 5;
+}
+
+/* The suffix is the source declaration name, not the assembler name.  */
+/* { dg-final { scan-assembler "\.section\[ \t\]+\.highcode\.source_name," } } */
+/* { dg-final { scan-assembler "assembler_name:" } } */
+/* { dg-final { scan-assembler "\.section\[ \t\]+\.highcode\.highcode_object," } } */
+/* { dg-final { scan-assembler "\.section\[ \t\]+\.highcode\.static_highcode_object," } } */
+/* { dg-final { scan-assembler "\.section\[ \t\]+\.highcode\.local_object," } } */
+
+/* Only the exact, case-sensitive .highcode spelling is rewritten.  */
+/* { dg-final { scan-assembler "\.section\[ \t\]+\.highcode\.extra," } } */
+/* { dg-final { scan-assembler-not "\.highcode\.extra\.prefix_name" } } */
+/* { dg-final { scan-assembler "\.section\[ \t\]+\.highcode_init," } } */
+/* { dg-final { scan-assembler-not "\.highcode_init\.init_name" } } */
+/* { dg-final { scan-assembler "\.section\[ \t\]+\.Highcode," } } */
+/* { dg-final { scan-assembler-not "\.Highcode\.case_name" } } */
+/* { dg-final { scan-assembler "\.section\[ \t\]+\.highcode ," } } */
+/* { dg-final { scan-assembler-not "\.highcode \.space_name" } } */
