@@ -0,0 +1,14 @@
+/* { dg-do compile } */
+/* { dg-options "-march=rv32imac -mabi=ilp32 --param=highcode-gen-section-name=1" } */
+
+int high_fn (int) __attribute__ ((section (".highcode")));
+int high_fn (int x) { return x + 1; }
+
+extern int high_obj __attribute__ ((section (".highcode")));
+int high_obj = 7;
