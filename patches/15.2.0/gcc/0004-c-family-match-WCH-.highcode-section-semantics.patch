 The number of elements for which hash table verification is done for each searched element.
 
+-param=highcode-gen-section-name=
+Common Joined UInteger Var(param_highcode_gen_section_name) Init(0) IntegerRange(0, 1) Param
+__attribute__((section(.highcode))) generate new section name.
+
 -param=hot-bb-count-fraction=
 Common Joined UInteger Var(param_hot_bb_count_fraction) Init(10000) Param
 The denominator n of fraction 1/n of the maximal execution count of a basic block in the entire program that a basic block needs to at least have in order to be considered hot (used in non-LTO mode).
diff --git a/gcc/testsuite/g++.target/riscv/wch-highcode-overload.C b/gcc/testsuite/g++.target/riscv/wch-highcode-overload.C
new file mode 100644
index 000000000..65ad41fb2
--- /dev/null
+++ b/gcc/testsuite/g++.target/riscv/wch-highcode-overload.C
@@ -0,0 +1,28 @@
+/* { dg-do compile } */
+/* { dg-options "-march=rv32imac -mabi=ilp32 --param=highcode-gen-section-name=1" } */
+
+namespace scope
+{
+int __attribute__ ((section (".highcode"), used))
+namespaced (int x)
+{
+  return x + 1;
+}
+}
+
+int __attribute__ ((section (".highcode"), used))
+overload (int x)
+{
+  return x + 2;
+}
+
+long __attribute__ ((section (".highcode"), used))
+overload (long x)
+{
+  return x + 3;
+}
+
+/* C++ sections use the source identifier, not namespace qualification or
+   mangled assembler names.  Both overloads therefore share one section.  */
+/* { dg-final { scan-assembler "\.section\[ \t\]+\.highcode\.namespaced," } } */
+/* { dg-final { scan-assembler-times "\.section\[ \t\]+\.highcode\.overload," 1 } } */
diff --git a/gcc/testsuite/gcc.target/riscv/wch-highcode-always-inline-default.c b/gcc/testsuite/gcc.target/riscv/wch-highcode-always-inline-default.c
new file mode 100644
index 000000000..03e9f02e4
--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/wch-highcode-always-inline-default.c
@@ -0,0 +1,14 @@
+/* { dg-do compile } */
+/* { dg-options "-march=rv32imac -mabi=ilp32 -O2" } */
+
+static __attribute__ ((always_inline, section (".highcode"))) inline int
+forced_callee (int x) /* { dg-error "inlining failed in call to 'always_inline'.*: function not inlinable" } */
+{
+  return x + 1;
+}
+
+int
+forced_caller (int x)
+{
+  return forced_callee (x); /* { dg-message "called from here" } */
+}
