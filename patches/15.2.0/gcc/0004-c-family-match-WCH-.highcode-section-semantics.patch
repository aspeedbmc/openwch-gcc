diff --git a/gcc/testsuite/gcc.target/riscv/wch-highcode-noinline-param0.c b/gcc/testsuite/gcc.target/riscv/wch-highcode-noinline-param0.c
new file mode 100644
index 000000000..5b2aafbb4
--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/wch-highcode-noinline-param0.c
@@ -0,0 +1,21 @@
+/* { dg-do compile } */
+/* { dg-options "-march=rv32imac -mabi=ilp32 -O2 -fdump-ipa-inline-details --param=highcode-gen-section-name=0" } */
+
+static int __attribute__ ((section (".highcode")))
+highcode_callee (int x)
+{
+  return x + 1;
+}
+
+int
+caller (int x)
+{
+  return highcode_callee (x);
+}
+
+/* Explicit value zero only disables section splitting; it does not permit
+   exact .highcode functions to be inlined.  */
+/* { dg-final { scan-assembler "\.section\[ \t\]+\.highcode," } } */
+/* { dg-final { scan-assembler-not "\.highcode\.highcode_callee" } } */
