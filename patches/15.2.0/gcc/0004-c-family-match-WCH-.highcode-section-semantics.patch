diff --git a/gcc/c-family/c-attribs.cc b/gcc/c-family/c-attribs.cc
index 5a0e3d328..89293db97 100644
--- a/gcc/c-family/c-attribs.cc
+++ b/gcc/c-family/c-attribs.cc
@@ -2627,6 +2627,17 @@ handle_section_attribute (tree *node, tree name, tree args,
      final processing.  */
   if (!(*no_add_attrs))
     {
+      if (strcmp (new_section_name, ".highcode") == 0)
+	{
+	  if (TREE_CODE (decl) == FUNCTION_DECL)
+	    DECL_UNINLINABLE (decl) = 1;
+
+	  if (param_highcode_gen_section_name)
+	    new_section_name = ACONCAT ((new_section_name, ".",
+					IDENTIFIER_POINTER (DECL_NAME (decl)),
+					NULL));
+	}
+
       set_decl_section_name (decl, new_section_name);
       return res;
     }
diff --git a/gcc/params.opt b/gcc/params.opt
index 64e453d29..f38c17078 100644
--- a/gcc/params.opt
+++ b/gcc/params.opt
@@ -205,6 +205,10 @@ Maximum number of blocks for in-line -fharden-control-flow-redundancy.
