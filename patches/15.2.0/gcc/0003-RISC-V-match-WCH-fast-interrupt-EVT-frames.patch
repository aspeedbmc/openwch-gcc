 gcc/config/riscv/riscv.cc                     | 48 ++++++++++++++++++-
 .../riscv/wch-fast-interrupt-epilogue-live.c  | 25 ++++++++++
 .../riscv/wch-fast-interrupt-float.c          | 20 ++++++++
 .../riscv/wch-fast-interrupt-leaf.c           | 14 ++++++
 .../riscv/wch-fast-interrupt-nonleaf.c        | 18 +++++++
 .../riscv/wch-fast-interrupt-warning.c        | 18 +++++++
 6 files changed, 141 insertions(+), 2 deletions(-)
