diff --git a/gcc/config/riscv/riscv.cc b/gcc/config/riscv/riscv.cc
index ed7af3682..3f62b00aa 100644
--- a/gcc/config/riscv/riscv.cc
+++ b/gcc/config/riscv/riscv.cc
@@ -7506,18 +7506,22 @@ riscv_save_return_addr_reg_p (void)
 
 /* Return true if REGNO is saved by the WCH fast-interrupt hardware prologue,
    so the software prologue must leave it alone: the GPRs a call may clobber,
-   plus the fixed ones that no prologue would save in any case.  ra is named
-   separately rather than left to call_used_or_fixed_reg_p, because
-   -fcall-saved-ra clears both of that predicate's inputs for it --
-   fix_register() declines only the stack and frame pointers -- while the
-   hardware saves it either way.  */
+   plus the fixed ones that no prologue would save in any case, and -- unless
+   --param=ccv-abi=1 asks for the vector ABI's callee-saved half -- the vector
+   registers.  ra is named separately rather than left to
+   call_used_or_fixed_reg_p, because -fcall-saved-ra clears both of that
+   predicate's inputs for it -- fix_register() declines only the stack and
+   frame pointers -- while the hardware saves it either way.  */
 
 static bool
 riscv_wch_fast_interrupt_saved_reg_p (unsigned int regno)
 {
-  return (GP_REG_P (regno)
-	  && (call_used_or_fixed_reg_p (regno)
-	      || regno == RETURN_ADDR_REGNUM));
+  return ((GP_REG_P (regno)
+	   && (call_used_or_fixed_reg_p (regno)
+	       || regno == RETURN_ADDR_REGNUM))
+	  || (V_REG_P (regno)
+	      && (!param_ccv_abi
+		  || riscv_v_abi ().clobbers_full_reg_p (regno))));
 }
 
 /* Return true if the current function must save register REGNO.  */
diff --git a/gcc/params.opt b/gcc/params.opt
index f38c17078..53eae79e7 100644
--- a/gcc/params.opt
+++ b/gcc/params.opt
@@ -114,6 +114,10 @@ The maximum length of a constant string for a builtin string cmp call eligible f
 Common Joined UInteger Var(param_case_values_threshold) Param Optimization
 The smallest number of different values for which it is best to use a jump-table instead of a tree of conditional branches, if 0, use the default for the machine.
 
+-param=ccv-abi=
+Common Joined UInteger Var(param_ccv_abi) Init(0) IntegerRange(0, 1) Param Optimization
+save v register.
+
 -param=comdat-sharing-probability=
 Common Joined UInteger Var(param_comdat_sharing_probability) Init(20) Param Optimization
 Probability that COMDAT function will be shared with different compilation unit.
diff --git a/gcc/testsuite/gcc.target/riscv/wch-fast-interrupt-vector-default.c b/gcc/testsuite/gcc.target/riscv/wch-fast-interrupt-vector-default.c
new file mode 100644
index 000000000..a65c6ed57
--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/wch-fast-interrupt-vector-default.c
@@ -0,0 +1,20 @@
+/* WCH fast interrupts do not software-save vector registers by default.  */
+/* { dg-do compile } */
+/* { dg-options "-O2 -march=rv32gcv -mabi=ilp32d" } */
+/* { dg-skip-if "" { *-*-* } { "-flto" } } */
+
+void __attribute__ ((interrupt ("WCH-Interrupt-fast")))
+handler (void)
+{
+  asm volatile ("" ::: "v0",  "v1",  "v2",  "v3",  "v4",  "v5",
+		       "v6",  "v7",  "v8",  "v9",  "v10", "v11",
+		       "v12", "v13", "v14", "v15", "v16", "v17",
+		       "v18", "v19", "v20", "v21", "v22", "v23",
+		       "v24", "v25", "v26", "v27", "v28", "v29",
+		       "v30", "v31");
+}
+
+/* { dg-final { scan-assembler-not {csrr\s+[atx][0-9]+,\s*vlenb} } } */
+/* { dg-final { scan-assembler-not {vs[1248]r\.v} } } */
+/* { dg-final { scan-assembler-not {vl[1248]re(8|16|32|64)\.v} } } */
+/* { dg-final { scan-assembler-times {\mmret\M} 1 } } */
