diff --git a/gcc/testsuite/gcc.target/riscv/wch-fast-interrupt-vector-param1-nonleaf.c b/gcc/testsuite/gcc.target/riscv/wch-fast-interrupt-vector-param1-nonleaf.c
new file mode 100644
index 000000000..76bd9cd13
--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/wch-fast-interrupt-vector-param1-nonleaf.c
@@ -0,0 +1,21 @@
+/* Non-leaf ccv-abi=1 handlers preserve all vector-ABI callee-saved regs.  */
+/* { dg-do compile } */
+/* { dg-options "-O2 -march=rv32gcv -mabi=ilp32d --param=ccv-abi=1" } */
+/* { dg-skip-if "" { *-*-* } { "-flto" } } */
+
+extern void callee (void);
+
+void __attribute__ ((interrupt ("WCH-Interrupt-fast")))
+handler (void)
+{
+  callee ();
+}
