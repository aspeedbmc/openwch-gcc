 .../riscv/wch-fast-interrupt-callee-saved.c   | 20 ++++++++++
 .../riscv/wch-fast-interrupt-float.c          | 16 ++++++++
 .../riscv/wch-fast-interrupt-leaf.c           | 15 ++++++++
 .../riscv/wch-fast-interrupt-mode.c           | 15 ++++++++
 .../riscv/wch-fast-interrupt-nonleaf.c        | 18 +++++++++
 .../riscv/wch-fast-interrupt-shrink-wrap.c    | 26 +++++++++++++
 .../riscv/wch-fast-interrupt-warning.c        | 21 ++++++++++
