diff --git a/gcc/testsuite/gcc.target/riscv/wch-highcode-always-inline.c b/gcc/testsuite/gcc.target/riscv/wch-highcode-always-inline.c
new file mode 100644
index 000000000..464f0c591
--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/wch-highcode-always-inline.c
@@ -0,0 +1,16 @@
+/* Verify the .highcode out-of-line rule is strong enough to reject
+   always_inline.  */
+/* { dg-do compile } */
+/* { dg-options "-O2 -march=rv32imac -mabi=ilp32" } */
+
+static __attribute__ ((always_inline, section (".highcode"))) inline int
+callee (int x) /* { dg-error "inlining failed in call to always_inline .callee.: function not inlinable" } */
+{
+  return x + 1;
+}
+
+int
+caller (int x)
+{
+  return callee (x); /* { dg-message "called from here" } */
+}
diff --git a/gcc/testsuite/gcc.target/riscv/wch-highcode-default-object.c b/gcc/testsuite/gcc.target/riscv/wch-highcode-default-object.c
