+++ b/gcc/testsuite/gcc.target/riscv/wch-highcode-default-object.c
@@ -0,0 +1,9 @@
+/* Verify a .highcode object is not split by default either.  A function and an
+   object cannot share one section, so this is a separate translation unit.  */
+/* { dg-do compile } */
+/* { dg-options "-O2 -march=rv32imac -mabi=ilp32" } */
