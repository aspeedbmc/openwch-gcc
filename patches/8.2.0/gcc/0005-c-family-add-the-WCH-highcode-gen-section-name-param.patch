diff --git a/gcc/testsuite/gcc.target/riscv/wch-highcode-sections.c b/gcc/testsuite/gcc.target/riscv/wch-highcode-sections.c
new file mode 100644
index 000000000..9fd3f1a16
--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/wch-highcode-sections.c
@@ -0,0 +1,35 @@
+/* Verify that only the exact .highcode section is split per declaration, and
+   that the suffix is the source declaration name.  */
+/* { dg-do compile } */
+/* { dg-options "-O2 -march=rv32imac -mabi=ilp32 --param highcode-gen-section-name=1" } */
+
+int source_name (int) __asm__ ("assembler_name");
+
+int __attribute__ ((section (".highcode"), used))
+source_name (int x) { return x + 1; }
+
+int __attribute__ ((section (".highcode.extra"), used))
+prefixed (int x) { return x + 2; }
+
+int __attribute__ ((section (".highcode_init"), used))
+underscored (int x) { return x + 3; }
+
+int __attribute__ ((section (".Highcode"), used))
+capitalized (int x) { return x + 4; }
+
+int __attribute__ ((section (".highcode "), used))
+trailing_space (int x) { return x + 5; }
+
+/* The suffix is the source name, not the assembler name.  */
+/* { dg-final { scan-assembler "\\.section\[ \t\]+\\.highcode\\.source_name," } } */
+/* { dg-final { scan-assembler "assembler_name:" } } */
+
+/* Every other spelling is left alone.  */
+/* { dg-final { scan-assembler "\\.section\[ \t\]+\\.highcode\\.extra," } } */
+/* { dg-final { scan-assembler-not "\\.highcode\\.extra\\.prefixed" } } */
+/* { dg-final { scan-assembler "\\.section\[ \t\]+\\.highcode_init," } } */
+/* { dg-final { scan-assembler-not "\\.highcode_init\\.underscored" } } */
+/* { dg-final { scan-assembler "\\.section\[ \t\]+\\.Highcode," } } */
+/* { dg-final { scan-assembler-not "\\.Highcode\\.capitalized" } } */
+/* { dg-final { scan-assembler "\\.section\[ \t\]+\\.highcode ," } } */
+/* { dg-final { scan-assembler-not "\\.highcode \\.trailing_space" } } */
diff --git a/gcc/testsuite/gcc.target/riscv/wch-highcode-variables.c b/gcc/testsuite/gcc.target/riscv/wch-highcode-variables.c
new file mode 100644
index 000000000..a86a8a193
--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/wch-highcode-variables.c
@@ -0,0 +1,18 @@
+/* Verify variables in .highcode are split too, function-local statics
+   included, using their source declaration names.  */
+/* { dg-do compile } */
+/* { dg-options "-O2 -march=rv32imac -mabi=ilp32 --param highcode-gen-section-name=1" } */
+
+int __attribute__ ((section (".highcode"), used)) global_obj = 1;
+static int __attribute__ ((section (".highcode"), used)) static_obj = 2;
+
+int
+owner (void)
+{
+  static int __attribute__ ((section (".highcode"), used)) local_obj = 3;
+  return local_obj + static_obj;
+}
+
+/* { dg-final { scan-assembler "\\.section\[ \t\]+\\.highcode\\.global_obj," } } */
+/* { dg-final { scan-assembler "\\.section\[ \t\]+\\.highcode\\.static_obj," } } */
+/* { dg-final { scan-assembler "\\.section\[ \t\]+\\.highcode\\.local_obj," } } */
