--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/wch-highcode-redeclaration.c
@@ -0,0 +1,17 @@
+/* Verify a repeated section attribute on one declaration is rewritten once and
+   does not report a conflict against its own rewritten name.  */
+/* { dg-do compile } */
+/* { dg-options "-O2 -march=rv32imac -mabi=ilp32 --param highcode-gen-section-name=1" } */
+
+int hfn (int) __attribute__ ((section (".highcode")));
+int hfn (int) __attribute__ ((section (".highcode")));
+int hfn (int x) { return x + 1; }
+
+extern int hobj __attribute__ ((section (".highcode")));
+extern int hobj __attribute__ ((section (".highcode")));
+int hobj = 7;
+
+/* { dg-final { scan-assembler "\\.section\[ \t\]+\\.highcode\\.hfn," } } */
+/* { dg-final { scan-assembler "\\.section\[ \t\]+\\.highcode\\.hobj," } } */
+/* { dg-final { scan-assembler-not "\\.highcode\\.hfn\\.hfn" } } */
