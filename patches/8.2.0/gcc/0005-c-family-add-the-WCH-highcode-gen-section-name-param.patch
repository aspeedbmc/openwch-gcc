diff --git a/gcc/c-family/c-attribs.c b/gcc/c-family/c-attribs.c
index c9e799e0f..a4048c659 100644
--- a/gcc/c-family/c-attribs.c
+++ b/gcc/c-family/c-attribs.c
@@ -43,6 +43,7 @@ along with GCC; see the file COPYING3.  If not see
 #include "toplev.h"
 #include "tree-iterator.h"
 #include "opts.h"
+#include "params.h"
 #include "gimplify.h"
 
 static tree handle_packed_attribute (tree *, tree, tree, int, bool *);
@@ -1673,6 +1674,7 @@ handle_section_attribute (tree *node, tree ARG_UNUSED (name), tree args,
 			  int ARG_UNUSED (flags), bool *no_add_attrs)
 {
   tree decl = *node;
+  const char *section_name;
 
   if (!targetm_common.have_named_sections)
     {
@@ -1702,11 +1704,28 @@ handle_section_attribute (tree *node, tree ARG_UNUSED (name), tree args,
       goto fail;
     }
 
+  section_name = TREE_STRING_POINTER (TREE_VALUE (args));
+
+  /* The exact .highcode section holds code that runs from fast memory, so it
+     must stay out of line.  Splitting each declaration into a section of its
+     own is optional, so that the linker script can place them one by one.  */
+  if (strcmp (section_name, ".highcode") == 0)
+    {
+      if (TREE_CODE (decl) == FUNCTION_DECL)
+	DECL_UNINLINABLE (decl) = 1;
+
+      if (PARAM_VALUE (PARAM_HIGHCODE_GEN_SECTION_NAME))
+	section_name = ACONCAT ((section_name, ".",
+				 IDENTIFIER_POINTER (DECL_NAME (decl)),
+				 NULL));
+    }
+
   /* The decl may have already been given a section attribute
-     from a previous declaration.  Ensure they match.  */
+     from a previous declaration.  Ensure they match.  Comparing the name
+     after the rewrite above lets a repeated attribute on the same
+     declaration agree with itself.  */
   if (DECL_SECTION_NAME (decl) != NULL
-      && strcmp (DECL_SECTION_NAME (decl),
-		 TREE_STRING_POINTER (TREE_VALUE (args))) != 0)
+      && strcmp (DECL_SECTION_NAME (decl), section_name) != 0)
     {
       error ("section of %q+D conflicts with previous declaration", *node);
       goto fail;
@@ -1720,7 +1739,7 @@ handle_section_attribute (tree *node, tree ARG_UNUSED (name), tree args,
       goto fail;
     }
 
-  set_decl_section_name (decl, TREE_STRING_POINTER (TREE_VALUE (args)));
+  set_decl_section_name (decl, section_name);
   return NULL_TREE;
 
 fail:
diff --git a/gcc/params.def b/gcc/params.def
