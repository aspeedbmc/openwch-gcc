diff --git a/opcodes/riscv-dis.c b/opcodes/riscv-dis.c
index 764c4d4d..d6842830 100644
--- a/opcodes/riscv-dis.c
+++ b/opcodes/riscv-dis.c
@@ -50,6 +50,10 @@ set_default_riscv_dis_options (void)
   riscv_gpr_names = riscv_gpr_names_abi;
   riscv_fpr_names = riscv_fpr_names_abi;
   no_aliases = 0;
+  /* The WCH XW compressed accesses occupy the Q0/Q2 double-precision slots,
+     so they cannot be decoded alongside them; leave them off until asked
+     for by name.  */
+  wch_rvc_extension = 0;
 }
 
 static void
@@ -62,6 +66,8 @@ parse_riscv_dis_option (const char *option)
       riscv_gpr_names = riscv_gpr_names_numeric;
       riscv_fpr_names = riscv_fpr_names_numeric;
     }
+  else if (strcmp (option, "xw") == 0)
+    wch_rvc_extension = 1;
   else
     {
       /* xgettext:c-format */
@@ -181,6 +187,21 @@ print_insn_args (const char *d, insn_t l, bfd_vma pc, disassemble_info *info)
 	    case 'N':
 	      print (info->stream, "%d", (int)EXTRACT_RVC_SDSP_IMM (l));
 	      break;
+	    /* WCH XW compressed byte/halfword offsets.  Lower case is the
+	       byte form and upper case the halfword form; b/B address off a
+	       register and h/H off sp, matching the assembler.  */
+	    case 'b':
+	      print (info->stream, "%d", (int)EXTRACT_RVC_XW_B_UIMM (l));
+	      break;
+	    case 'B':
+	      print (info->stream, "%d", (int)EXTRACT_RVC_XW_H_UIMM (l));
+	      break;
+	    case 'h':
+	      print (info->stream, "%d", (int)EXTRACT_RVC_XW_BSP_UIMM (l));
+	      break;
+	    case 'H':
+	      print (info->stream, "%d", (int)EXTRACT_RVC_XW_HSP_UIMM (l));
+	      break;
 	    case 'p':
 	      info->target = EXTRACT_RVC_B_IMM (l) + pc;
 	      (*info->print_address_func) (info->target, info);
@@ -549,5 +570,9 @@ with the -M switch (multiple options should be separated by commas):\n"));
   no-aliases    Disassemble only into canonical instructions, rather\n\
                 than into pseudoinstructions.\n"));
 
+  fprintf (stream, _("\n\
+  xw            Enable WCH compressed instruction extension, such as\n\
+  \t\t\t\t\t\t\tlbu lhu sb sh lbusp lhusp sbsp shsp .\n"));
+
   fprintf (stream, _("\n"));
 }
