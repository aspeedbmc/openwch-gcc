diff --git a/gas/config/tc-riscv.c b/gas/config/tc-riscv.c
index 99b007f5..4490b374 100644
--- a/gas/config/tc-riscv.c
+++ b/gas/config/tc-riscv.c
@@ -144,6 +144,15 @@ riscv_set_arch (const char *s)
 
   riscv_release_subset_list (&riscv_subsets);
   riscv_parse_subset (&rps, s);
+
+  /* The WCH XW compressed accesses need both the vendor extension and the
+     compressed base they encode into, so they are selected only by an
+     architecture naming xw together with c.  This looks at the parsed
+     subset list rather than riscv_subset_supports, because .option rvc
+     enables the compressed instructions without selecting XW.  */
+  if (riscv_lookup_subset (&riscv_subsets, "xw")
+      && riscv_lookup_subset (&riscv_subsets, "c"))
+    wch_rvc_extension = 1;
 }
 
 /* Handle of the OPCODE hash table.  */
@@ -571,7 +580,11 @@ validate_riscv_insn (const struct riscv_opcode *opc, int length)
 	switch (c = *p++)
 	  {
 	  case 'a': used_bits |= ENCODE_RVC_J_IMM (-1U); break;
+	  case 'b': used_bits |= ENCODE_RVC_XW_B_UIMM (-1U); break;
+	  case 'B': used_bits |= ENCODE_RVC_XW_H_UIMM (-1U); break;
 	  case 'c': break; /* RS1, constrained to equal sp */
+	  case 'h': used_bits |= ENCODE_RVC_XW_BSP_UIMM (-1U); break;
+	  case 'H': used_bits |= ENCODE_RVC_XW_HSP_UIMM (-1U); break;
 	  case 'i': used_bits |= ENCODE_RVC_SIMM3(-1U); break;
 	  case 'j': used_bits |= ENCODE_RVC_IMM (-1U); break;
 	  case 'o': used_bits |= ENCODE_RVC_IMM (-1U); break;
@@ -1523,6 +1536,46 @@ rvc_imm_done:
 		    break;
 		  ip->insn_opcode |= ENCODE_RVC_IMM (imm_expr->X_add_number);
 		  goto rvc_imm_done;
+		case 'b':
+		  if (riscv_handle_implicit_zero_offset (imm_expr, s))
+		    continue;
+		  if (my_getSmallExpression (imm_expr, imm_reloc, s, p)
+		      || imm_expr->X_op != O_constant
+		      || !VALID_RVC_XW_B_UIMM (imm_expr->X_add_number))
+		    break;
+		  ip->insn_opcode |=
+		    ENCODE_RVC_XW_B_UIMM (imm_expr->X_add_number);
+		  goto rvc_imm_done;
+		case 'B':
+		  if (riscv_handle_implicit_zero_offset (imm_expr, s))
+		    continue;
+		  if (my_getSmallExpression (imm_expr, imm_reloc, s, p)
+		      || imm_expr->X_op != O_constant
+		      || !VALID_RVC_XW_H_UIMM (imm_expr->X_add_number))
+		    break;
+		  ip->insn_opcode |=
+		    ENCODE_RVC_XW_H_UIMM (imm_expr->X_add_number);
+		  goto rvc_imm_done;
+		case 'h':
+		  if (riscv_handle_implicit_zero_offset (imm_expr, s))
+		    continue;
+		  if (my_getSmallExpression (imm_expr, imm_reloc, s, p)
+		      || imm_expr->X_op != O_constant
+		      || !VALID_RVC_XW_BSP_UIMM (imm_expr->X_add_number))
+		    break;
+		  ip->insn_opcode |=
+		    ENCODE_RVC_XW_BSP_UIMM (imm_expr->X_add_number);
+		  goto rvc_imm_done;
+		case 'H':
+		  if (riscv_handle_implicit_zero_offset (imm_expr, s))
+		    continue;
+		  if (my_getSmallExpression (imm_expr, imm_reloc, s, p)
+		      || imm_expr->X_op != O_constant
+		      || !VALID_RVC_XW_HSP_UIMM (imm_expr->X_add_number))
+		    break;
+		  ip->insn_opcode |=
+		    ENCODE_RVC_XW_HSP_UIMM (imm_expr->X_add_number);
+		  goto rvc_imm_done;
 		case 'k':
 		  if (riscv_handle_implicit_zero_offset (imm_expr, s))
 		    continue;
