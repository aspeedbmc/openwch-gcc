diff --git a/gas/config/tc-riscv.c b/gas/config/tc-riscv.c
index 145d9e54..6817646d 100644
--- a/gas/config/tc-riscv.c
+++ b/gas/config/tc-riscv.c
@@ -134,6 +134,11 @@ static enum float_abi float_abi = FLOAT_ABI_DEFAULT;
 
 static unsigned elf_flags = 0;
 
+/* Emit the finish-time privilege-version attributes.  WCH builds keep
+   this off by default and expose it through a hidden command-line flag,
+   so it is intentionally omitted from md_show_usage.  */
+static bool w_priv_spec = false;
+
 /* Set the default_isa_spec.  Return 0 if the spec isn't supported.
    Otherwise, return 1.  */
 
@@ -3400,6 +3405,7 @@ enum options
   OPTION_MPRIV_SPEC,
   OPTION_BIG_ENDIAN,
   OPTION_LITTLE_ENDIAN,
+  OPTION_W_PRIV_SPEC,
   OPTION_END_OF_ENUM
 };
 
@@ -3420,6 +3426,7 @@ struct option md_longopts[] =
   {"mpriv-spec", required_argument, NULL, OPTION_MPRIV_SPEC},
   {"mbig-endian", no_argument, NULL, OPTION_BIG_ENDIAN},
   {"mlittle-endian", no_argument, NULL, OPTION_LITTLE_ENDIAN},
+  {"w_priv_spec", no_argument, NULL, OPTION_W_PRIV_SPEC},
 
   {NULL, no_argument, NULL, 0}
 };
@@ -3504,6 +3511,10 @@ md_parse_option (int c, const char *arg)
       target_big_endian = 0;
       break;
 
+    case OPTION_W_PRIV_SPEC:
+      w_priv_spec = true;
+      break;
+
     default:
       return 0;
     }
@@ -4405,6 +4416,13 @@ riscv_write_out_attrs (void)
   bfd_elf_add_proc_attr_string (stdoutput, Tag_RISCV_arch, arch_str);
   xfree ((void *) arch_str);
 
+  /* WCH 12.2 canonicalizes the architecture attribute but synthesizes the
+     finish-time privilege-version attributes only when asked to.  The
+     attributes an input wrote explicitly are unaffected: they were
+     recorded when the directive was parsed.  */
+  if (!w_priv_spec)
+    return;
+
   /* For the file without any instruction, we don't set the default_priv_spec
      according to the privileged elf attributes since the md_assemble isn't
      called.  */
