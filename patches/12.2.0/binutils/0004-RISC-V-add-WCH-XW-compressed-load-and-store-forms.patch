diff --git a/include/opcode/riscv.h b/include/opcode/riscv.h
index d33f6d37..2fdf09f4 100644
--- a/include/opcode/riscv.h
+++ b/include/opcode/riscv.h
@@ -345,6 +345,29 @@ static const char * const riscv_pred_succ[16] =
 #define EXTRACT_BITS(STRUCT, MASK, SHIFT) \
   (((STRUCT) >> (SHIFT)) & (MASK))
 
+#define EXTRACT_XW_REG_BYTE_UIMM(x) \
+  (RV_X(x, 12, 1) | (RV_X(x, 5, 2) << 1) | (RV_X(x, 10, 2) << 3))
+#define EXTRACT_XW_REG_HALF_UIMM(x) \
+  ((RV_X(x, 5, 2) << 1) | (RV_X(x, 10, 2) << 3) | (RV_X(x, 12, 1) << 5))
+#define EXTRACT_XW_SP_BYTE_UIMM(x) (RV_X(x, 7, 4))
+#define EXTRACT_XW_SP_HALF_UIMM(x) \
+  ((RV_X(x, 8, 3) << 1) | (RV_X(x, 7, 1) << 4))
+#define ENCODE_XW_REG_BYTE_UIMM(x) \
+  ((RV_X(x, 0, 1) << 12) | (RV_X(x, 1, 2) << 5) | (RV_X(x, 3, 2) << 10))
+#define ENCODE_XW_REG_HALF_UIMM(x) \
+  ((RV_X(x, 1, 2) << 5) | (RV_X(x, 3, 2) << 10) | (RV_X(x, 5, 1) << 12))
+#define ENCODE_XW_SP_BYTE_UIMM(x) (RV_X(x, 0, 4) << 7)
+#define ENCODE_XW_SP_HALF_UIMM(x) \
+  ((RV_X(x, 1, 3) << 8) | (RV_X(x, 4, 1) << 7))
+#define VALID_XW_REG_BYTE_UIMM(x) \
+  (EXTRACT_XW_REG_BYTE_UIMM (ENCODE_XW_REG_BYTE_UIMM (x)) == (x))
+#define VALID_XW_REG_HALF_UIMM(x) \
