@@ -24,6 +24,22 @@
 #define MATCH_SLLI_RV32 0x1013
 #define MASK_SLLI_RV32  0xfe00707f
 #define MATCH_MCPY 0x0000700f
+#define MATCH_XW_C_LBU 0x2000
