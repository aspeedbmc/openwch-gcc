diff --git a/gas/config/tc-riscv.c b/gas/config/tc-riscv.c
index df7902f2..145d9e54 100644
--- a/gas/config/tc-riscv.c
+++ b/gas/config/tc-riscv.c
@@ -246,6 +246,14 @@ static riscv_parse_subset_t riscv_rps_as =
   true,			/* check_unknown_prefixed_ext.  */
 };
 
+/* WCH only enables XW compressed encodings when C and XW have appeared in
+   the command-line architecture or an ELF architecture attribute.  Only
+   riscv_set_arch sets this, so `.option arch, +xw' does not turn it on,
+   and because it is not part of struct riscv_option_stack neither does
+   `.option pop' turn it back off: eligibility is decided once by the
+   initial architecture and then sticks for the whole file.  */
+static bool xw_enabled;
+
 /* This structure is used to hold a stack of .option values.  */
 struct riscv_option_stack
 {
@@ -278,6 +286,9 @@ riscv_set_arch (const char *s)
   riscv_release_subset_list (riscv_subsets);
   riscv_parse_subset (&riscv_rps_as, s);
 
+  xw_enabled |= (riscv_subset_supports (&riscv_rps_as, "xw")
+		  && riscv_subset_supports (&riscv_rps_as, "c"));
+
   riscv_set_rvc (false);
   if (riscv_subset_supports (&riscv_rps_as, "c"))
     riscv_set_rvc (true);
@@ -1105,6 +1116,19 @@ validate_riscv_insn (const struct riscv_opcode *opc, int length)
 	      goto unknown_validate_operand;
 	    }
 	  break;  /* end RVC */
+	case 'X': /* Vendor-specific operands.  */
+	  if (*++oparg == 'w')
+	    switch (*++oparg)
+	      {
+	      case 'b': used_bits |= ENCODE_XW_REG_BYTE_UIMM (-1U); break;
+	      case 'h': used_bits |= ENCODE_XW_REG_HALF_UIMM (-1U); break;
+	      case 'B': used_bits |= ENCODE_XW_SP_BYTE_UIMM (-1U); break;
+	      case 'H': used_bits |= ENCODE_XW_SP_HALF_UIMM (-1U); break;
+	      default: goto unknown_validate_operand;
+	      }
+	  else
+	    goto unknown_validate_operand;
+	  break;
 	case 'V': /* RVV */
 	  switch (*++oparg)
 	    {
@@ -2251,7 +2275,27 @@ riscv_ip (char *str, struct riscv_cl_insn *ip, expressionS *imm_expr,
       if ((insn->xlen_requirement != 0) && (xlen != insn->xlen_requirement))
 	continue;
 
-      if (!riscv_multi_subset_supports (&riscv_rps_as, insn->insn_class))
+      /* riscv_multi_subset_supports has no INSN_CLASS_XW case and
+	 reports `internal: unreachable INSN_CLASS_*' if it is reached
+	 with one, so an enabled XW instruction has to bypass it.  Here
+	 that is done by nesting rather than joining the chain below;
+	 the disassembler does the same with an explicit class test.  */
+      if (insn->insn_class == INSN_CLASS_XW)
+	{
+	  if (!xw_enabled)
+	    {
+	      if (riscv_opts.rvc)
+		error = _("illegal operands");
+	      continue;
+	    }
+	}
+      else if (insn->insn_class == INSN_CLASS_D_AND_C && xw_enabled)
+	{
+	  error = _("illegal operands");
+	  continue;
+	}
+      else if (!riscv_multi_subset_supports (&riscv_rps_as,
+					     insn->insn_class))
 	continue;
 
       /* Reset error message of the previous round.  */
@@ -3148,6 +3192,52 @@ riscv_ip (char *str, struct riscv_cl_insn *ip, expressionS *imm_expr,
 		}
 	      break;
 
+	    case 'X': /* Vendor-specific operands.  */
+	      if (*++oparg != 'w')
+		goto unknown_riscv_ip_operand;
+	      switch (*++oparg)
+		{
+		case 'b':
+		  if (riscv_handle_implicit_zero_offset (imm_expr, asarg))
+		    continue;
+		  if (my_getSmallExpression (imm_expr, imm_reloc, asarg, p)
+		      || imm_expr->X_op != O_constant
+		      || !VALID_XW_REG_BYTE_UIMM (imm_expr->X_add_number))
+		    break;
+		  ip->insn_opcode |= ENCODE_XW_REG_BYTE_UIMM (imm_expr->X_add_number);
+		  goto rvc_imm_done;
+		case 'h':
+		  if (riscv_handle_implicit_zero_offset (imm_expr, asarg))
+		    continue;
+		  if (my_getSmallExpression (imm_expr, imm_reloc, asarg, p)
+		      || imm_expr->X_op != O_constant
+		      || !VALID_XW_REG_HALF_UIMM (imm_expr->X_add_number))
+		    break;
+		  ip->insn_opcode |= ENCODE_XW_REG_HALF_UIMM (imm_expr->X_add_number);
+		  goto rvc_imm_done;
+		case 'B':
+		  if (riscv_handle_implicit_zero_offset (imm_expr, asarg))
+		    continue;
+		  if (my_getSmallExpression (imm_expr, imm_reloc, asarg, p)
+		      || imm_expr->X_op != O_constant
+		      || !VALID_XW_SP_BYTE_UIMM (imm_expr->X_add_number))
+		    break;
+		  ip->insn_opcode |= ENCODE_XW_SP_BYTE_UIMM (imm_expr->X_add_number);
+		  goto rvc_imm_done;
+		case 'H':
+		  if (riscv_handle_implicit_zero_offset (imm_expr, asarg))
+		    continue;
+		  if (my_getSmallExpression (imm_expr, imm_reloc, asarg, p)
+		      || imm_expr->X_op != O_constant
+		      || !VALID_XW_SP_HALF_UIMM (imm_expr->X_add_number))
+		    break;
+		  ip->insn_opcode |= ENCODE_XW_SP_HALF_UIMM (imm_expr->X_add_number);
+		  goto rvc_imm_done;
+		default:
+		  goto unknown_riscv_ip_operand;
+		}
+	      break;
+
 	    case 'y': /* bs immediate */
 	      my_getExpression (imm_expr, asarg);
 	      check_absolute_expr (ip, imm_expr, FALSE);
