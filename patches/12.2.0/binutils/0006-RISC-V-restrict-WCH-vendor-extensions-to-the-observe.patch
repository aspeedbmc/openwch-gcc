diff --git a/bfd/elfxx-riscv.c b/bfd/elfxx-riscv.c
index 8308939f..83bb8c98 100644
--- a/bfd/elfxx-riscv.c
+++ b/bfd/elfxx-riscv.c
@@ -1247,6 +1247,7 @@ static struct riscv_supported_ext riscv_supported_std_zxm_ext[] =
 static struct riscv_supported_ext riscv_supported_std_x_ext[] =
 {
   {"xw", ISA_SPEC_CLASS_DRAFT, 1, 0, 0},
+  {"x", ISA_SPEC_CLASS_DRAFT, 1, 0, 0},
   {NULL, 0, 0, 0, 0}
 };
 
@@ -1342,9 +1343,7 @@ riscv_recognized_prefixed_ext (const char *ext)
   case RV_ISA_CLASS_H:
     return riscv_known_prefixed_ext (ext, riscv_supported_std_h_ext);
   case RV_ISA_CLASS_X:
-    /* Only the single x is unrecognized.  */
-    if (strcmp (ext, "x") != 0)
-      return true;
+    return riscv_known_prefixed_ext (ext, riscv_supported_std_x_ext);
   default:
     break;
   }
