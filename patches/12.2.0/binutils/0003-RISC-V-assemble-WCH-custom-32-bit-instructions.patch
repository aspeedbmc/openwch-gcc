diff --git a/opcodes/riscv-dis.c b/opcodes/riscv-dis.c
index 34724d4a..5f988123 100644
--- a/opcodes/riscv-dis.c
+++ b/opcodes/riscv-dis.c
@@ -386,6 +386,11 @@ print_insn_args (const char *oparg, insn_t l, bfd_vma pc, disassemble_info *info
 		 riscv_gpr_names[EXTRACT_OPERAND (RS2, l)]);
 	  break;
 
+	case 'r':
+	  print (info->stream, "%s",
+		 riscv_gpr_names[EXTRACT_OPERAND (RS3, l)]);
+	  break;
+
 	case 'u':
 	  print (info->stream, "0x%x",
 		 (unsigned)EXTRACT_UTYPE_IMM (l) >> RISCV_IMM_BITS);
@@ -460,6 +465,20 @@ print_insn_args (const char *oparg, insn_t l, bfd_vma pc, disassemble_info *info
 	  print (info->stream, "0x%x", (int)EXTRACT_OPERAND (SHAMTW, l));
 	  break;
 
+	case 'F':
+	  switch (*++oparg)
+	    {
+	    case '5':
+	      print (info->stream, "%u",
+		     (unsigned) EXTRACT_OPERAND (FUNCT5, l));
+	      break;
+	    default:
+	      print (info->stream, _("# internal error, undefined modifier (%c)"),
+		     *oparg);
+	      return;
+	    }
+	  break;
+
 	case 'S':
 	case 'U':
 	  print (info->stream, "%s", riscv_fpr_names[rs1]);
