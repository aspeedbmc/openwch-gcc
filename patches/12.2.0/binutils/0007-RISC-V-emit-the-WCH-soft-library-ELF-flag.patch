diff --git a/gas/testsuite/gas/riscv/wch-softlib.s b/gas/testsuite/gas/riscv/wch-softlib.s
new file mode 100644
index 00000000..47478810
--- /dev/null
+++ b/gas/testsuite/gas/riscv/wch-softlib.s
@@ -0,0 +1,3 @@
+	call	target
+target:
+	ret
diff --git a/include/elf/riscv.h b/include/elf/riscv.h
index d0acf688..7b3108fc 100644
--- a/include/elf/riscv.h
+++ b/include/elf/riscv.h
@@ -114,6 +114,9 @@ END_RELOC_NUMBERS (R_RISCV_max)
 /* File uses the 32E base integer instruction.  */
 #define EF_RISCV_RVE 0x0008
 
+/* File is intended for the WCH software library ABI.  */
+#define EF_RISCV_WCH_SOFTLIB 0x01000000
+
 /* The name of the global pointer symbol.  */
 #define RISCV_GP_SYMBOL "__global_pointer$"
 
