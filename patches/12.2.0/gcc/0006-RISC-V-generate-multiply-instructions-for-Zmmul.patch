index 000000000..92e9b98ce
--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/wch-zmmul.c
@@ -0,0 +1,39 @@
+/* { dg-do compile } */
+/* { dg-options "-march=rv32i_zmmul -mabi=ilp32 -O2" } */
+
+int
+mul (int a, int b)
+{
+  return a * b;
+}
+
+int
+div (int a, int b)
+{
+  return a / b;
+}
+
+long long
+smul (int a, int b)
+{
+  return (long long) a * b;
+}
+
+unsigned long long
+umul (unsigned int a, unsigned int b)
+{
+  return (unsigned long long) a * b;
+}
+
+long long
+usmul (unsigned int a, int b)
+{
+  return (long long) a * b;
+}
+
