From 86c40fd2b84f60b670f05d6241ff3e09150d61c7 Mon Sep 17 00:00:00 2001
From: OpenWCH Phase 4 <phase4@openwch.local>
Date: Thu, 13 Aug 2026 07:31:50 +0900
Subject: [PATCH 8/9] RISC-V: truncate RV32 integer-building intermediates

When an RV32 constant is decomposed into an upper part and ADDI low part, keep the intermediate in the requested machine mode. This lets 0x7fffffff use LUI followed by ADDI -1 instead of selecting a same-cost XORI sequence from an untruncated host-width value.

Behavior specification: tmp/phase4-evidence/s3-integer-7fffffff/probe.c; tmp/phase4-evidence/s3-integer-7fffffff/official-O0.s; tmp/phase4-evidence/s3-integer-7fffffff/official-O1.s; tmp/phase4-evidence/s3-integer-7fffffff/official-O2.s; tmp/phase4-evidence/s3-integer-7fffffff/official-Os.s; matching candidate outputs in the same directory.

gcc/ChangeLog:

	* config/riscv/riscv.cc (riscv_build_integer_1): Truncate the upper
	part to the requested mode.

gcc/testsuite/ChangeLog:

	* gcc.target/riscv/rv32-load-7fffffff.c: New test.
---
 gcc/config/riscv/riscv.cc                           |  6 +++++-
 gcc/testsuite/gcc.target/riscv/rv32-load-7fffffff.c | 11 +++++++++++
 2 files changed, 16 insertions(+), 1 deletion(-)
 create mode 100644 gcc/testsuite/gcc.target/riscv/rv32-load-7fffffff.c

diff --git a/gcc/config/riscv/riscv.cc b/gcc/config/riscv/riscv.cc
index 8ba59eea8..4e16ef947 100644
--- a/gcc/config/riscv/riscv.cc
+++ b/gcc/config/riscv/riscv.cc
@@ -441,7 +441,11 @@ riscv_build_integer_1 (struct riscv_integer_op codes[RISCV_MAX_INTEGER_OPS],
       && (mode != HImode
 	  || value - low_part <= ((1 << (GET_MODE_BITSIZE (HImode) - 1)) - 1)))
     {
-      alt_cost = 1 + riscv_build_integer_1 (alt_codes, value - low_part, mode);
+      HOST_WIDE_INT upper_part = value - low_part;
+      if (mode != VOIDmode)
+	upper_part = trunc_int_for_mode (upper_part, mode);
+
+      alt_cost = 1 + riscv_build_integer_1 (alt_codes, upper_part, mode);
       if (alt_cost < cost)
 	{
 	  alt_codes[alt_cost-1].code = PLUS;
diff --git a/gcc/testsuite/gcc.target/riscv/rv32-load-7fffffff.c b/gcc/testsuite/gcc.target/riscv/rv32-load-7fffffff.c
new file mode 100644
index 000000000..2f0dbafbf
--- /dev/null
+++ b/gcc/testsuite/gcc.target/riscv/rv32-load-7fffffff.c
@@ -0,0 +1,11 @@
+/* { dg-do compile } */
+/* { dg-options "-O0 -march=rv32imac -mabi=ilp32" } */
+
+unsigned int
+f (void)
+{
+  return 0x7fffffffu;
+}
+
+/* { dg-final { scan-assembler "addi\ta5,a5,-1" } } */
+/* { dg-final { scan-assembler-not "xori" } } */
